# Copy to .env next to compose.yaml. Compose reads it on every command, so settings here apply to every
# `up`, `pull`, `run` and `logs` without exporting anything. Commented lines show the built-in defaults.

# Compose project name; replaces `-p`. Changing it later starts a separate, empty stack.
COMPOSE_PROJECT_NAME=zeroterm-bastion

# Directory holding production.toml, maintenance.toml, nginx.conf and tls/ (relative to compose.yaml, or absolute).
#BASTION_CONFIG_DIR=./.local/docker

# Pin reviewed images, e.g. ghcr.io/notpeppa/zeroterm-terminal@sha256:...
#BASTION_IMAGE=ghcr.io/notpeppa/zeroterm-terminal:latest
#GUACD_IMAGE=ghcr.io/notpeppa/zeroterm-terminal-guacd:1.6.0-strict-pin

# Host port of the bundled TLS proxy.
#BASTION_HTTPS_PORT=443

# Minimum password length in bytes (8-32), enforced for every password.
#BASTION_PASSWORD_MIN_LENGTH=12

# First administrator, used only while no administrator exists. Leave the password unset to have one generated
# and printed once to the bootstrap-admin log. If you set it, remove the line after the first start.
#BASTION_ADMIN_USERNAME=admin
#BASTION_ADMIN_PASSWORD=
#BASTION_ADMIN_PASSWORD_FILE=
